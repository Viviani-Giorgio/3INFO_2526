body {
    font-family: Arial, sans-serif;
    max-width: 760px;
    margin: 0 auto;
    padding: 30px 20px;
    background-color: #111827;
    color: #e5e7eb;
    line-height: 1.6;
}

h1 {
    margin-bottom: 5px;
    color: #f9fafb;
}

h2 {
    margin-top: 25px;
    color: #60a5fa;
}

p, li {
    font-size: 16px;
}

ul {
    padding-left: 0;
    list-style: none;
}

li {
    margin-bottom: 12px;
    padding: 12px 14px;
    background-color: #1f2937;
    border-left: 4px solid #60a5fa;
    border-radius: 8px;
}

hr {
    border: none;
    border-top: 2px solid #374151;
    margin: 20px 0;
}
